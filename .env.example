# Copy is unnecessary. scripts/init-env.sh writes .env on first boot.
# Every sign-in password is SharedInfraDev2026A. Encryption keys stay blank here;
# init-env.sh fills those. Fill ENV_NAME, PUBLIC_HOST, and the storage connection
# string, then run scripts/up.sh.
# Quote any value that contains spaces, semicolons, or hashes.

ENV_NAME=
PUBLIC_HOST=
AZURE_STORAGE_CONNECTION_STRING=

AZURE_QUEUE_NAME=app-logs
AZURE_POISON_QUEUE_NAME=app-logs-poison

LOG_RETENTION_DAYS=30
PROMETHEUS_RETENTION_TIME=15d
PROMETHEUS_RETENTION_SIZE=8GB
LOKI_RETENTION_PERIOD=168h
N8N_EXECUTIONS_DATA_MAX_AGE=168

ALERT_WEBHOOK_URL=
ALERT_TARGET_DOWN_FOR=2m
ALERT_QUEUE_DEPTH=1000
ALERT_QUEUE_FOR=10m
ALERT_DISK_FREE_RATIO=0.15
ALERT_DISK_FOR=10m
ALERT_ES_YELLOW_FOR=5m
ALERT_ES_RED_FOR=1m
ALERT_INDEX_PAUSE_FOR=15m
ALERT_POISON_SPIKE_MULTIPLIER=5
ALERT_POISON_SPIKE_FOR=10m
ALERT_POISON_SPIKE_WINDOW=5m
ALERT_POISON_SPIKE_BASELINE=1h
ALERT_POISON_SPIKE_MIN_RATE=0.01

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=SharedInfraDev2026A

ELASTIC_PASSWORD=SharedInfraDev2026A
KIBANA_SYSTEM_PASSWORD=SharedInfraDev2026A
LOGS_WRITER_PASSWORD=SharedInfraDev2026A
LOGS_READER_PASSWORD=SharedInfraDev2026A

LANGFUSE_INIT_USER_EMAIL=ops@example.com
LANGFUSE_INIT_USER_NAME=Ops
LANGFUSE_INIT_USER_PASSWORD=SharedInfraDev2026A
LANGFUSE_NEXTAUTH_SECRET=
LANGFUSE_SALT=
LANGFUSE_ENCRYPTION_KEY=
LANGFUSE_INIT_PROJECT_PUBLIC_KEY=
LANGFUSE_INIT_PROJECT_SECRET_KEY=
LANGFUSE_OTLP_AUTH_HEADER=
LANGFUSE_POSTGRES_PASSWORD=SharedInfraDev2026A
CLICKHOUSE_PASSWORD=SharedInfraDev2026A
REDIS_PASSWORD=SharedInfraDev2026A
MINIO_ROOT_PASSWORD=SharedInfraDev2026A

MLFLOW_ADMIN_USER=admin
MLFLOW_ADMIN_PASSWORD=SharedInfraDev2026A
